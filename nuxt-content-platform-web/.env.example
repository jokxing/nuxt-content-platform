# ContentPulse / 讯览 — 本地环境示例（不含密钥）
# 复制为 .env 后按需修改。勿填入原生产域名或凭据。

NUXT_PUBLIC_SITE_URL=http://localhost:3666
NUXT_PUBLIC_DOMAIN=http://localhost:3666
# 仅演示时钟；不是资讯真实后端开关
NUXT_PUBLIC_USE_MOCK=true

# 资讯联调（私有，不进入 runtimeConfig.public / 浏览器）
# false 或未设置：Nitro 继续本地 Mock 资讯；统计始终 Mock
# true：Nitro 仅代理 articles/categories/content-directory 到 Express，失败不回退 Mock
NUXT_CONTENT_API_USE_REAL=false
NUXT_CONTENT_API_BASE_URL=http://127.0.0.1:4000

# 旧生产监听/部署脚本已退役，不能用环境变量恢复。
# sitemap 本地生成无需开关；命令行脚本的站点地址需通过进程环境传入。
# 真实构建前需后端可用：pnpm prepare:content 会请求一次 /api/content-directory。
