{
  "name": "nuxt-content-platform-web",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "prepare:content": "tsx scripts/prepare-content-directory.ts",
    "build": "tsx scripts/prepare-content-directory.ts && tsx scripts/generate-sitemaps.ts && nuxt build",
    "dev": "nuxt dev --port 3666",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint --edit",
    "typecheck": "nuxi typecheck",
    "update-sitemaps": "tsx scripts/prepare-content-directory.ts && tsx scripts/generate-sitemaps.ts",
    "generate-routes": "tsx scripts/generate-prerender-routes.ts",
    "audit:seo": "node scripts/audit-seo-output.mjs"
  },
  "dependencies": {
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "9.5.5",
    "chart.js": "^4.5.0",
    "chartjs-chart-matrix": "^3.0.0",
    "chinese-simple2traditional": "^2.2.2",
    "nuxt": "4.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "vue": "3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@iconify-json/carbon": "^1.2.8",
    "@nuxt/eslint": "^1.4.1",
    "@pinia/nuxt": "^0.11.2",
    "@unocss/eslint-plugin": "66.1.3",
    "@unocss/nuxt": "66.1.3",
    "@vant/nuxt": "^1.0.7",
    "autoprefixer": "^10.4.21",
    "bumpp": "^10.1.1",
    "eslint": "^9.28.0",
    "eslint-plugin-format": "^1.0.1",
    "lint-staged": "^16.1.0",
    "pinia": "^3.0.3",
    "postcss-mobile-forever": "^5.0.0",
    "sass": "^1.89.2",
    "simple-git-hooks": "^2.13.0",
    "terser": "^5.44.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "unocss": "^66.1.3",
    "vant": "^4.9.19",
    "vue-tsc": "^2.2.10"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "5.8.3"
      }
    },
    "allowedDeprecatedVersions": {
      "glob": "*",
      "inflight": "1",
      "are-we-there-yet": "2",
      "gauge": "3",
      "node-domexception": "1",
      "npmlog": "5",
      "rimraf": "3",
      "@types/parse-path": "7",
      "@oxc-parser/wasm": "0.60.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "simple-git-hooks",
      "unrs-resolver"
    ]
  },
  "resolutions": {
    "vite": "^6.3.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint $1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "browserslist": [
    "defaults"
  ]
}
