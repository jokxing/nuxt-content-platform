generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id         Int                   @id @default(autoincrement())
  slug       String                @unique @db.VarChar(50)
  parentRoute String               @map("parent_route") @db.VarChar(20)
  sortOrder  Int                   @map("sort_order")
  translations CategoryTranslation[]
  articles   Article[]

  @@map("categories")
}

model CategoryTranslation {
  categoryId Int      @map("category_id")
  locale     String   @db.VarChar(10)
  name       String   @db.VarChar(100)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model Article {
  id          Int                  @id @default(autoincrement())
  slug        String               @unique @db.VarChar(160)
  categoryId  Int                  @map("category_id")
  author      String               @db.VarChar(100)
  coverImage  String               @default("/logo.svg") @map("cover_image") @db.VarChar(500)
  status      ArticleStatus        @default(DRAFT)
  publishedAt DateTime?            @map("published_at") @db.DateTime(3)
  version     Int                  @default(1)
  createdAt   DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  category    Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations ArticleTranslation[]

  @@index([status, publishedAt, id], map: "articles_status_published_at_id_idx")
  @@index([categoryId, status, publishedAt, id], map: "articles_category_status_published_at_id_idx")
  @@map("articles")
}

model ArticleTranslation {
  articleId Int     @map("article_id")
  locale    String  @db.VarChar(10)
  title     String  @db.VarChar(200)
  content   String  @db.MediumText
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, locale])
  @@map("article_translations")
}

enum DatasetPeriodStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DatasetScheduleStatus {
  SCHEDULED
  CANCELLED
  PUBLISHED
}

/// 已发布数据期次（公开统计只读 PUBLISHED 且 releasedAt <= now）
model DatasetPeriod {
  id          Int                 @id @default(autoincrement())
  periodCode  String              @unique @map("period_code") @db.VarChar(32)
  releasedAt  DateTime            @map("released_at") @db.DateTime(3)
  value1      Int                 @map("value_1")
  value2      Int                 @map("value_2")
  value3      Int                 @map("value_3")
  value4      Int                 @map("value_4")
  value5      Int                 @map("value_5")
  value6      Int                 @map("value_6")
  extraValue  Int                 @map("extra_value")
  status      DatasetPeriodStatus @default(DRAFT)
  createdAt   DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, releasedAt, id], map: "dataset_periods_status_released_at_id_idx")
  @@map("dataset_periods")
}

/// 下一次计划发布（latest 取最早未来 SCHEDULED）
model DatasetSchedule {
  id              Int                   @id @default(autoincrement())
  periodCode      String                @unique @map("period_code") @db.VarChar(32)
  scheduledAt     DateTime              @map("scheduled_at") @db.DateTime(3)
  status          DatasetScheduleStatus @default(SCHEDULED)
  createdAt       DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, scheduledAt], map: "dataset_schedules_status_scheduled_at_idx")
  @@map("dataset_schedules")
}

/// 预置单管理员账号；密码只存哈希，不开放注册。
model AdminUser {
  id           Int            @id @default(autoincrement())
  username     String         @unique @db.VarChar(100)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  displayName  String         @map("display_name") @db.VarChar(100)
  isActive     Boolean        @default(true) @map("is_active")
  lastLoginAt  DateTime?      @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  sessions     AdminSession[]
  mediaAssets  MediaAsset[]

  @@map("admin_users")
}

/// Opaque 会话；数据库只保存 token / CSRF 的 SHA-256 哈希。
model AdminSession {
  id                Int        @id @default(autoincrement())
  adminUserId       Int        @map("admin_user_id")
  tokenHash         String     @unique @map("token_hash") @db.Char(64)
  csrfTokenHash     String     @map("csrf_token_hash") @db.Char(64)
  idleExpiresAt     DateTime   @map("idle_expires_at") @db.DateTime(3)
  absoluteExpiresAt DateTime   @map("absolute_expires_at") @db.DateTime(3)
  lastSeenAt        DateTime   @map("last_seen_at") @db.DateTime(3)
  revokedAt         DateTime?  @map("revoked_at") @db.DateTime(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  adminUser         AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId], map: "admin_sessions_admin_user_id_idx")
  @@index([idleExpiresAt], map: "admin_sessions_idle_expires_at_idx")
  @@index([absoluteExpiresAt], map: "admin_sessions_absolute_expires_at_idx")
  @@index([revokedAt], map: "admin_sessions_revoked_at_idx")
  @@map("admin_sessions")
}

/// 上传封面元数据；与 Article.cover_image 无外键，靠 url 扫描引用。
model MediaAsset {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(255)
  url         String    @db.VarChar(500)
  mimeType    String    @map("mime_type") @db.VarChar(64)
  width       Int
  height      Int
  sizeBytes   Int       @map("size_bytes")
  adminUserId Int?      @map("admin_user_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  orphanedAt  DateTime? @map("orphaned_at") @db.DateTime(3)
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "media_assets_created_at_idx")
  @@index([adminUserId], map: "media_assets_admin_user_id_idx")
  @@map("media_assets")
}
