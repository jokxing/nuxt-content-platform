{
  "name": "nuxt-content-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:sanitize": "tsx --test src/lib/htmlSanitize.test.ts",
    "test:integration": "tsx --test src/api.integration.test.ts",
    "test:unit": "tsx --test src/lib/htmlSanitize.test.ts src/config/env.test.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "openapi:validate": "tsx scripts/openapi-validate.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "sanitize-html": "2.17.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@eslint/js": "9.36.0",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/sanitize-html": "2.16.1",
    "eslint": "9.36.0",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/engines"
    ]
  }
}
