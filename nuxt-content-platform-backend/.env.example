# Copy to `.env` in this directory. Do not commit real passwords.
# Special characters in passwords must be URL-encoded (@ → %40, : → %3A, / → %2F, # → %23, etc.).
# Do not reuse AI multimodal or other project databases.
# See docs/backend/MYSQL_SETUP.md

NODE_ENV=development
PORT=4000

# 仅 NODE_ENV=test 或本开关为 true 时挂载 /__debug；production 禁止为 true
ENABLE_DEBUG_ROUTES=false

# Required for migrate / seed / /health DB probe (B2+).
DATABASE_URL="mysql://content_platform_dev:CHANGE_ME_URL_ENCODED@127.0.0.1:3306/content_platform_dev"
SHADOW_DATABASE_URL="mysql://content_platform_dev:CHANGE_ME_URL_ENCODED@127.0.0.1:3306/content_platform_shadow"

# --- A2 管理认证（无真实密钥示例）---
# 管理站 Origin 白名单（逗号分隔）。本地同时允许 localhost 与 127.0.0.1，避免入口主机名不同导致写请求被拒绝。
ADMIN_ALLOWED_ORIGINS=http://localhost:3670,http://127.0.0.1:3670
# 缺少 Origin 时是否放行；仅本地/测试可 true，production 禁止
ADMIN_ALLOW_MISSING_ORIGIN=false
# Cookie Secure；缺省时 production=true，开发/测试通常 false
# ADMIN_COOKIE_SECURE=false

# 仅 `pnpm admin:ensure` 读取：只创建缺失管理员，不写进 seed，不要把真密码提交仓库。
ADMIN_BOOTSTRAP_USERNAME=CHANGE_ME_LOCAL_ADMIN
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_LOCAL_STRONG_PASSWORD
ADMIN_BOOTSTRAP_DISPLAY_NAME=CHANGE_ME_LOCAL_DISPLAY_NAME

# --- A5.3 媒体上传 ---
# 公开媒体基址（无尾斜杠）。本地适配器配合 GET /media/*；生产为 R2 自定义域，例如 https://media.example.com
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:4000/media
# local（默认）或 r2
MEDIA_STORAGE_DRIVER=local
# 可选：本地磁盘根目录，默认 nuxt-content-platform-backend/.data/media
# MEDIA_LOCAL_ROOT=
# R2（仅 MEDIA_STORAGE_DRIVER=r2 时需要；勿提交真实密钥）
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# --- A7 GitHub Actions 构建 worker ---
# Token 仅放后端环境变量，最小权限为目标仓库 Actions: write、Contents: read；不要提交真值。
# BUILD_GITHUB_OWNER=your-github-account
# BUILD_GITHUB_REPO=nuxt-content-platform
# BUILD_GITHUB_WORKFLOW=content-deploy.yml
# BUILD_GITHUB_REF=main
# BUILD_GITHUB_TOKEN=
# 连续内容事件合并窗口（0～180 秒）与 worker 轮询间隔（10～3600 秒）。
BUILD_MERGE_WINDOW_SECONDS=120
BUILD_WORKER_INTERVAL_SECONDS=30
