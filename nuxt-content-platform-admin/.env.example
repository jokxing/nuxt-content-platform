# 管理端环境变量示例（无真实密钥）
# 复制为 .env 后按需填写；切勿提交真实密码、会话密钥、GitHub Token 或 Cloudflare Hook。

# 开发服务端口由 package.json scripts 指定为 3670

# 私有：管理 API 上游（仅 Nitro BFF 使用，不进入 public runtimeConfig）
NUXT_ADMIN_API_BASE_URL=http://127.0.0.1:4000

# 公开站预览基址（仅用于生成预览链接展示，不含认证）
# 缺省与 app/constants/site.ts 中 DEFAULT_PUBLIC_SITE_URL 一致
NUXT_PUBLIC_SITE_URL=http://localhost:3666

# 可信媒体公开基址（无尾斜杠），须与后端 MEDIA_PUBLIC_BASE_URL 一致；不含密钥
NUXT_PUBLIC_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:4000/media

# Nitro 请求体上限（字节），略高于业务 5 MiB，容纳 multipart 边界
NITRO_MAX_REQUEST_BODY_SIZE=6291456
