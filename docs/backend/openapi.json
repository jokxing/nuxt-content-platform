    },
    "/api/content-directory": {
      "get": {
        "operationId": "getContentDirectory",
        "summary": "构建用完整内容快照",
        "tags": [
          "资讯查询"
        ],
        "description": "设计契约，尚未实现。拒绝未知/重复/数组/空 query 参数。公开内容只返回已发布、发布时间已到且三语齐全的记录。 按 id 升序，一致读快照，上限 10000 篇；超过时 503 CONTENT_DIRECTORY_LIMIT_EXCEEDED，不能截断。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentDirectory"
                },
                "example": {
                  "generated_at": "2026-09-19T00:00:00.000Z",
                  "articles": [
                    {
                      "id": 101,
                      "parent_route": "education",
                      "status": 1,
                      "publish_date": "2026-09-10T02:00:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数不合法",
