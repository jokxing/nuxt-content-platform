                      "parent_route": "education"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 40000,
                  "msg": "参数不合法",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          },
          "500": {
            "description": "内部服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 50000,
                  "msg": "内部服务错误",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 50300,
                  "msg": "服务暂不可用",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          }
        }
      }
    },
    "/api/articles": {
      "get": {
        "operationId": "listArticles",
