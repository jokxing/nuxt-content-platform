    "/api/content-directory": {
      "get": {
        "operationId": "getContentDirectory",
        "summary": "构建用完整内容快照",
        "tags": [
          "资讯查询"
        ],
        "description": "已实现。拒绝未知/重复/数组/空 query 参数。公开内容只返回已发布、发布时间已到且三语齐全的记录。按 id 升序，一致读快照，上限 10000 篇；超过时 HTTP 503 + code 50301，不能截断。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentDirectoryResponse"
                },
                "example": {
                  "code": 0,
                  "msg": "ok",
                  "data": {
                    "generated_at": 1789804800000,
                    "articles": [
                      {
                        "id": 101,
                        "parent_route": "education",
                        "status": 1,
                        "publish_date": 1789005600000
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 40000,
                  "msg": "参数不合法",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          },
          "500": {
            "description": "内部服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 50000,
                  "msg": "内部服务错误",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用或内容目录超过上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "unavailable": {
                    "summary": "数据库不可用",
                    "value": {
                      "code": 50300,
                      "msg": "服务暂不可用",
                      "data": null,
                      "requestId": "example-request-id"
                    }
                  },
                  "limit": {
                    "summary": "目录超限",
                    "value": {
                      "code": 50301,
                      "msg": "内容目录超过上限",
                      "data": null,
                      "requestId": "example-request-id"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
