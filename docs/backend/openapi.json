        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticlePageResponse"
                },
                "example": {
                  "code": 0,
                  "msg": "ok",
                  "data": {
                    "items": [
                      {
                        "id": 101,
                        "title": "如何阅读数据面板",
