                        "cover_image": "/logo.svg",
                        "status": 1,
                        "category": "新手指南",
                        "category_slug": "how-to-play",
                        "parent_route": "education"
                      }
                    ],
                    "total": 1,
                    "page": 1,
                    "page_size": 10,
                    "total_pages": 1
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 40000,
                  "msg": "参数不合法",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          },
          "500": {
            "description": "内部服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 50000,
                  "msg": "内部服务错误",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 50300,
                  "msg": "服务暂不可用",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          }
        }
      }
    },
