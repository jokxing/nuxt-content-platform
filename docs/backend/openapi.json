                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INVALID_ARGUMENT",
                    "message": "参数不合法",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          },
