        "tags": [
          "资讯查询"
        ],
        "description": "设计契约，尚未实现。拒绝未知/重复/数组/空 query 参数。公开内容只返回已发布、发布时间已到且三语齐全的记录。",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "zh-HK",
                "zh-CN",
                "en-US",
                "tc",
                "sc",
                "en"
              ],
              "default": "zh-HK"
            },
            "description": "tc/sc/en 分别映射 zh-HK/zh-CN/en-US；空值、重复或数组参数返回 400"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "education",
                "analysis",
                "story",
                "how-to-play",
                "skills",
                "play-desc",
                "this-predict",
                "last-review",
                "tema-rule",
                "lottery-news",
                "win-story",
                "activity-news",
                "lottery-teach",
                "ai-predict",
                "news-story"
              ]
            },
            "description": "父类、子类或兼容别名；不传查询全部"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
