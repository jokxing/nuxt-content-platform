  "components": {
    "schemas": {
      "Article": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "slug",
          "content",
          "publish_date",
          "author",
          "cover_image",
          "status",
          "category",
          "category_slug",
          "parent_route"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "description": "白名单清理后的 HTML，列表也保留正文以兼容当前前端"
          },
          "publish_date": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601"
          },
          "author": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "cover_image": {
            "type": "string",
            "maxLength": 500,
            "description": "仅 /logo.svg 或本站 /images/ 相对路径，不含 .."
          },
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "category_slug": {
            "type": "string",
            "enum": [
              "how-to-play",
              "skills",
              "play-desc",
              "this-predict",
              "last-review",
              "tema-rule",
              "lottery-news",
              "win-story",
              "activity-news"
            ]
          },
          "parent_route": {
            "type": "string",
            "enum": [
              "education",
              "analysis",
              "story"
            ]
          }
        }
      },
      "ArticlePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Article"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "total_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "Category": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "parent_route"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "how-to-play",
              "skills",
              "play-desc",
              "this-predict",
              "last-review",
              "tema-rule",
              "lottery-news",
              "win-story",
              "activity-news"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "parent_route": {
            "type": "string",
            "enum": [
              "education",
              "analysis",
              "story"
            ]
          }
        }
      },
      "CategoryList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        }
      },
      "DirectoryArticle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parent_route",
          "status",
          "publish_date"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "parent_route": {
            "type": "string",
            "enum": [
              "education",
              "analysis",
              "story"
            ]
          },
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "publish_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContentDirectory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generated_at",
          "articles"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "articles": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/DirectoryArticle"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "ARTICLE_NOT_FOUND",
                  "INTERNAL_ERROR",
                  "SERVICE_UNAVAILABLE",
                  "CONTENT_DIRECTORY_LIMIT_EXCEEDED"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 500
              },
              "requestId": {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
