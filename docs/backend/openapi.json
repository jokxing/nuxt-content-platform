  "components": {
    "schemas": {
      "Article": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "slug",
          "content",
          "publish_date",
          "author",
          "cover_image",
          "status",
          "category",
          "category_slug",
          "parent_route"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "description": "白名单清理后的 HTML，列表也保留正文以兼容当前前端"
          },
          "publish_date": {
            "type": "integer",
            "format": "int64",
            "description": "Unix 毫秒时间戳（UTC）",
            "example": 1789005600000
          },
          "author": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "cover_image": {
            "type": "string",
            "maxLength": 500,
            "description": "仅 /logo.svg 或本站 /images/ 相对路径，不含 .."
          },
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "category_slug": {
            "type": "string",
            "enum": [
              "how-to-play",
              "skills",
              "play-desc",
              "this-predict",
              "last-review",
              "tema-rule",
              "lottery-news",
              "win-story",
              "activity-news"
            ]
          },
          "parent_route": {
            "type": "string",
            "enum": [
              "education",
              "analysis",
              "story"
            ]
          }
        }
      },
      "Category": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "parent_route"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "how-to-play",
              "skills",
              "play-desc",
              "this-predict",
              "last-review",
              "tema-rule",
              "lottery-news",
              "win-story",
              "activity-news"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "parent_route": {
            "type": "string",
            "enum": [
              "education",
              "analysis",
              "story"
            ]
          }
        }
      },
      "DirectoryArticle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parent_route",
          "status",
          "publish_date"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "parent_route": {
            "type": "string",
            "enum": [
              "education",
              "analysis",
              "story"
            ]
          },
          "status": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "publish_date": {
            "type": "integer",
            "format": "int64",
            "description": "Unix 毫秒时间戳（UTC）",
            "example": 1789005600000
          }
        }
      },
      "ContentDirectory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generated_at",
          "articles"
        ],
        "properties": {
          "generated_at": {
            "type": "integer",
            "format": "int64",
            "description": "Unix 毫秒时间戳（UTC）",
            "example": 1789804800000
          },
          "articles": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/DirectoryArticle"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "msg",
          "data",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              40000,
              40400,
              40401,
              50000,
              50300,
              50301
            ],
            "description": "非零数字业务码；符号名仅用于常量与文档"
          },
          "msg": {
            "type": "string",
            "maxLength": 500
          },
          "data": {
            "type": "null"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "ArticlePageData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Article"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "total_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "msg",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              0
            ]
          },
          "msg": {
            "type": "string",
            "maxLength": 200,
            "example": "ok"
          },
          "data": {
            "$ref": "#/components/schemas/Health"
          }
        }
      },
      "CategoryListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "msg",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              0
            ]
          },
          "msg": {
            "type": "string",
            "maxLength": 200,
            "example": "ok"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        }
      },
      "ArticlePageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "msg",
          "data"
