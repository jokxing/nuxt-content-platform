{
  "openapi": "3.0.3",
  "info": {
    "title": "ContentPulse 后端 API：第一批资讯查询",
    "version": "0.1.0",
    "description": "设计阶段，尚未实现。仅五个公开查询接口；统计、认证和发布待独立批次追加。规则与数据模型见 BACKEND_CONTRACT.md。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000",
      "description": "拟定本地 Express 地址，需先实现并启动"
    }
  ],
  "tags": [
    {
      "name": "运行状态"
    },
    {
      "name": "资讯查询"
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "服务与数据库就绪检查",
        "tags": [
          "运行状态"
        ],
        "description": "设计契约，尚未实现。拒绝未知/重复/数组/空 query 参数。公开内容只返回已发布、发布时间已到且三语齐全的记录。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok",
                  "database": "up"
                }
              }
            }
          },
          "400": {
            "description": "参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INVALID_ARGUMENT",
                    "message": "参数不合法",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          },
          "500": {
            "description": "内部服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "内部服务错误",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "服务暂不可用",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "九个子分类的本地化名称",
        "tags": [
          "资讯查询"
        ],
        "description": "设计契约，尚未实现。拒绝未知/重复/数组/空 query 参数。公开内容只返回已发布、发布时间已到且三语齐全的记录。",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "zh-HK",
                "zh-CN",
                "en-US",
                "tc",
                "sc",
                "en"
              ],
              "default": "zh-HK"
            },
            "description": "tc/sc/en 分别映射 zh-HK/zh-CN/en-US；空值、重复或数组参数返回 400"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryList"
                },
                "example": {
                  "data": [
                    {
                      "slug": "how-to-play",
                      "name": "新手指南",
                      "parent_route": "education"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INVALID_ARGUMENT",
                    "message": "参数不合法",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          },
          "500": {
            "description": "内部服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "内部服务错误",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "服务暂不可用",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/articles": {
      "get": {
        "operationId": "listArticles",
        "summary": "已发布文章列表",
        "tags": [
          "资讯查询"
        ],
        "description": "设计契约，尚未实现。拒绝未知/重复/数组/空 query 参数。公开内容只返回已发布、发布时间已到且三语齐全的记录。",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "zh-HK",
                "zh-CN",
                "en-US",
                "tc",
                "sc",
                "en"
              ],
              "default": "zh-HK"
            },
            "description": "tc/sc/en 分别映射 zh-HK/zh-CN/en-US；空值、重复或数组参数返回 400"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "education",
                "analysis",
                "story",
                "how-to-play",
                "skills",
                "play-desc",
                "this-predict",
                "last-review",
                "tema-rule",
                "lottery-news",
                "win-story",
                "activity-news",
                "lottery-teach",
                "ai-predict",
                "news-story"
              ]
            },
            "description": "父类、子类或兼容别名；不传查询全部"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            },
            "description": "默认 1；仅正十进制整数"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "description": "默认 10；最大 50"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticlePage"
                },
                "example": {
                  "data": [
                    {
                      "id": 101,
                      "title": "如何阅读数据面板",
                      "slug": "how-to-read-dashboard",
                      "content": "<p>本篇介绍数据面板的结构与筛选方式。</p>",
                      "publish_date": "2026-09-10T02:00:00.000Z",
                      "author": "ContentPulse Editor",
                      "cover_image": "/logo.svg",
                      "status": 1,
                      "category": "新手指南",
                      "category_slug": "how-to-play",
                      "parent_route": "education"
                    }
                  ],
                  "total": 1,
                  "page": 1,
                  "page_size": 10,
                  "total_pages": 1
                }
              }
            }
          },
          "400": {
            "description": "参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INVALID_ARGUMENT",
                    "message": "参数不合法",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          },
          "500": {
            "description": "内部服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "内部服务错误",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "服务暂不可用",
                    "requestId": "example-request-id"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/articles/{id}": {
      "get": {
        "operationId": "getArticle",
        "summary": "文章详情",
        "tags": [
          "资讯查询"
        ],
        "description": "设计契约，尚未实现。拒绝未知/重复/数组/空 query 参数。公开内容只返回已发布、发布时间已到且三语齐全的记录。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "description": "仅数字 ID；非法 400，不存在或不可见 404"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "zh-HK",
                "zh-CN",
                "en-US",
                "tc",
                "sc",
                "en"
              ],
              "default": "zh-HK"
            },
            "description": "tc/sc/en 分别映射 zh-HK/zh-CN/en-US；空值、重复或数组参数返回 400"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                },
