{
  "openapi": "3.0.3",
  "info": {
    "title": "ContentPulse 后端 API：第一批资讯查询",
    "version": "0.1.0",
    "description": "第一批资讯查询接口。成功统一 { code:0, msg, data }；失败统一 { code:非零数字, msg, data:null, requestId }。HTTP 状态码仍使用 400/404/500/503。规则见 BACKEND_CONTRACT.md。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000",
      "description": "拟定本地 Express 地址，需先实现并启动"
    }
  ],
  "tags": [
    {
      "name": "运行状态"
    },
    {
      "name": "资讯查询"
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "服务与数据库就绪检查",
        "tags": [
          "运行状态"
        ],
        "description": "设计契约，尚未实现。拒绝未知/重复/数组/空 query 参数。公开内容只返回已发布、发布时间已到且三语齐全的记录。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "code": 0,
                  "msg": "ok",
                  "data": {
                    "status": "ok",
                    "database": "up"
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 40000,
                  "msg": "参数不合法",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          },
          "500": {
            "description": "内部服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 50000,
                  "msg": "内部服务错误",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "code": 50300,
                  "msg": "服务暂不可用",
                  "data": null,
                  "requestId": "example-request-id"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "九个子分类的本地化名称",
        "tags": [
          "资讯查询"
        ],
        "description": "设计契约，尚未实现。拒绝未知/重复/数组/空 query 参数。公开内容只返回已发布、发布时间已到且三语齐全的记录。",
